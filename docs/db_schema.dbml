// multidevice-study-pipeline: DBML for dbdiagram.io
// Source: deploy/postgres/init/02_registry.sql ... 05_accounts.sql

Project "multidevice_study_pipeline" {
  database_type: 'PostgreSQL'
  note: '''

      Postgres + PostGIS + TimescaleDB store for a study conducted with multiple device types, for multiple participant sites, and rotating device assignments over time.

      ## Schemas
      - **registry**: the study design. Participants (`ppt`), devices (`dvc`), accounts (`acc`), sites and device types, synced from `study_registry.yml`, which is the source of truth. `registry.usr` links one participant, one device and one account over a date window, and constraints prevent overlapping windows per device and per account.
      - **raw**: pipeline records. `ingests` holds each raw API payload as JSONB (append-only), `pipeline` logs the status of each run (one row per usr per run, updated once when the run ends), and `pull_coverage` records which date ranges have been fully pulled (append-only), so backfills only fetch the gaps.
      - **readings**: processed data, with typed columns, standardized units and UTC timestamps. Every device type requires a TimescaleDB hypertable for longitudinal visualization (e.g., `readings.atmotube2`, `readings.fitbit6`). If a device type has heterogeneous data, it may require additional tables to fit it into a longitudinal table (e.g., `readings.fitbit6_*`)
      - **accounts**: optional snapshots of account data from a device with an account (e.g. Fitbit profile data). A row is appended only when the data differs from the latest snapshot.

      ## Conventions
      - `usr_id` identifies an *assignment* (participant + device + account over time), not a person. A participant who switches devices gets a new `usr` row, so join through `registry.usr.ppt_id` to combine their data.
      - Every processed row carries an `ingest_id` pointing back to the raw payload it came from.
      - Readings are upserted on their unique key (`usr_id` + time), so re-pulling an overlapping date range is safe.
      - Timestamps are `timestamptz` in UTC. Column suffixes give the unit (`_bpm`, `_pct`, `_mm`, `_kcal`).

      ## Registry sync
      `config/study_registry.yml` is the single source of truth. Running `python -m load.scripts.seed_registry` makes `registry.*` mirror it in one transaction (any error rolls everything back):
      - New values in the yml are inserted, changed values are updated, and values removed from the yml are deleted (children before parents).
      - `registry.usr` rows keep their `id` when only dates or accounts change, so readings stay attached to the same usr. A change that would orphan loaded data is refused by the foreign keys.
      - The yml is validated first. A bad yml (unset env variable, type mismatch, overlapping windows) changes nothing.
      - Credentials are read from the yml in memory and are never written to the database.
      - The sync is run manually. The scheduled daily job does not call it.

      ## Data flow
      Registry sync (manual): `study_registry.yml` → `registry.*`.

      Daily pipeline: `extract` → `raw.ingests` → `transform` → `readings.*` / `accounts.usr`. `raw.pipeline` logs each usr's load (running, then success, partial or failed). `raw.pull_coverage` is written after a successful load by the backfill and CSV-loader scripts (the daily job does not record coverage yet).

      Views and indexes are not shown here.
  '''
}



// ---------------------------------------------------------------------------
// registry: data ABOUT devices and participants (synced from study_registry.yml)
// ---------------------------------------------------------------------------

Table registry.type {
  id text [pk]

  Note: 'Device types from the yml types list. Only an id, so a rename is an insert of the new value and a delete of the old one.'
}

Table registry.site {
  id text [pk]

  Note: 'Sites from the yml sites list. Only an id, so a rename is an insert of the new value and a delete of the old one.'
}

Table registry.dvc {
  id text [pk]
  type text [not null]
  started_at date [not null]
  ended_at date
  notes text
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, type) [unique]
  }
}

Table registry.ppt {
  id text [pk]
  site text [not null]
  started_at date [not null]
  ended_at date
  notes text
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, site) [unique]
  }
}

Table registry.acc {
  id text [pk]
  type text [not null]
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, type) [unique]
  }

  Note: 'Account data only. No credentials are stored.'
}

Table registry.usr {
  id bigint [pk, increment]
  ppt_id text [not null]
  dvc_id text [not null]
  acc_id text [not null]
  type text [not null, note: 'same type on device and account/access']
  site text [not null, note: 'same site as the participant']
  started_at date [not null]
  ended_at date
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, type) [unique]
  }
  Note: '''
    CENTRAL. participant + device + account/access over a time window = user. EXCLUDE constraints prevent overlapping windows per device and per account.

    The foreign keys to dvc and acc (ON UPDATE CASCADE) and the two overlap constraints are DEFERRABLE INITIALLY IMMEDIATE. The registry sync defers them at the start of its transaction, so a device and its account can change type together and the checks run at COMMIT. The key to ppt cascades site changes only.
  '''
}
// ---------------------------------------------------------------------------
// raw: pipeline metadata and raw payloads
// ---------------------------------------------------------------------------

Table raw.ingests {
  id bigint [pk, increment]
  usr_id bigint [not null]
  type text [not null]
  ingest_method text [not null, note: '''
    api_forwardfill | api_backfill | csv_backfill | test
  ''']
  pulled_at timestamptz [not null, default: `now()`]
  payload jsonb [not null]

  indexes {
    (usr_id, pulled_at) [name: 'idx_ingests']
  }
  Note: 'To backup the raw data. Append-only: one row per usr per pull.'
}

Table raw.pipeline {
  id bigint [pk, increment]
  usr_id bigint [not null]
  type text [not null]
  status text [not null, default: 'running', note: 'running | success | partial | failed']
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  error_message text

  indexes {
    (usr_id, started_at) [name: 'idx_pipeline']
  }
  Note: 'To monitor the pipeline runs. One row per usr per run: inserted as running when the load starts, then updated once with the final status.'
}

Table raw.pull_coverage {
  id bigint [pk, increment]
  usr_id bigint [not null]
  type text [not null]
  data_type text [not null, note: 'endpoint name from the type registry']
  covered tstzrange [not null, note: '[start, end) in UTC that the pull fully scanned']
  status text [not null, note: 'success | partial | failed']
  rows_loaded integer [not null]
  pages integer
  ingest_id bigint [not null]
  pulled_at timestamptz [not null, default: `now()`]

  indexes {
    (usr_id, data_type) [name: 'idx_pull_coverage']
  }
  Note: '''
    To track time gaps in the data. Append-only. Written after a successful load, only for ranges that were scanned to the end. Only success rows count as covered, and raw.pull_gaps() uses them to find the date ranges a backfill still needs to pull.

    Currently written by the backfill and CSV-loader scripts. The daily job does not record coverage yet.
  '''
}

// ---------------------------------------------------------------------------
// readings: processed device data
// ---------------------------------------------------------------------------

Table readings.atmotube2 {
  usr_id bigint [not null, note: 'Assignment (participant + device + account), not a person. Join via registry.usr.ppt_id to combine a participant\'s data.']
  recorded_at timestamptz [not null, note: '''
    Datasheet: `datetime`. ISO 8601, UTC-aware. Standardized timestamp and the key used to merge all parser category tables.
  ''']
  aqs integer [note: '''
    Datasheet: `aqs_total`. Unit: score 0-100 (integer), 0 = polluted, 100 = clean.
    Aggregate Air Quality Score combining PM, TVOC, CO2 and NOx. Not a weather measurement, even though the parser pulls it alongside weather columns.
  ''']

  // --- Particulate matter (Sensirion SPS30) ---
  pm1 double [note: 'Datasheet: `pm1_0_ugm3_atm`. Unit: ug/m3. Mass concentration of particulate matter <= 1.0 um. Sensor: Sensirion SPS30.']
  pm25 double [note: 'Datasheet: `pm2_5_ugm3_atm`. Unit: ug/m3. Mass concentration of particulate matter <= 2.5 um. Sensor: Sensirion SPS30.']
  pm10 double [note: 'Datasheet: `pm10_ugm3_atm`. Unit: ug/m3. Mass concentration of particulate matter <= 10 um. Sensor: Sensirion SPS30.']

  // --- PM extension (PRO 2 only) ---
  pm_size double [note: '''
    Datasheet: `pmsize_um_avg`. Unit: um. Average particle size, converted from nm (nm / 1000).
    PRO 2 only. The original nm value (`pmsize_nm_avg`) has no column here.
  ''']
  pm05_num integer [note: 'Datasheet: `pm0_5_um_count`. Unit: count per unit volume. Number of particles with diameter beyond 0.5 um. PRO 2 only.']
  pm1_num integer [note: 'Datasheet: `pm1_0_um_count`. Unit: count. Number of particles with diameter beyond 1.0 um. PRO 2 only.']
  pm10_num integer [note: 'Datasheet: `pm10_um_count`. Unit: count. Number of particles with diameter beyond 10 um. PRO 2 only.']
  pm25_num integer [note: 'Datasheet: `pm2_5_um_count`. Unit: count. Number of particles with diameter beyond 2.5 um. PRO 2 only.']

  // --- Weather (Bosch BME280) ---
  temperature double [note: 'Datasheet: `temp_c`. Unit: degC. Ambient temperature. Sensor: Bosch BME280. Used downstream for heat index and dew point.']
  humidity double [note: '''
    Datasheet: `hum_pct`. Unit: %. Relative humidity: water vapor in the air relative to the maximum it can hold at that temperature (0% = dry, 100% = saturated).
    Sensor: Bosch BME280. Used downstream for heat index and dew point.
  ''']
  pressure double [note: '''
    Datasheet: `press_hpa`. Unit: hPa. Atmospheric pressure at the current elevation (NOT adjusted to sea level).
    Sensor: Bosch BME280. Used downstream for heat index and dew point.
  ''']

  // --- Gas (TVOC / NOx / CO2) ---
  voc double [note: '''
    Datasheet: `tvoc_ppm`. Unit: ppm. Absolute concentration of Total Volatile Organic Compounds in one volume of air.
    Sensor: Sensirion SGP41 (PRO 2 only; the original PRO uses the TVOC-only SGPC3).
  ''']
  voc_index integer [note: '''
    Datasheet: `tvoc_index`. Unit: index, 0-500. TVOC score relative to a rolling 24-hour baseline.
    100 = baseline, >100 = becoming more polluted, <100 = becoming cleaner. Sensor: Sensirion SGP41.
  ''']
  nox_index integer [note: '''
    Datasheet: `nox_index`. Unit: index, 0-500. Score for nitric oxide (NO) and nitrogen dioxide (NO2) relative to a rolling 24-hour baseline (100 = baseline).
    Sensor: Sensirion SGP41 (the SGP40 has no NOx capability).
  ''']
  co2 double [note: 'Datasheet: `co2_ppm`. Unit: ppm. Absolute concentration of carbon dioxide in one volume of air. Sensor: Sensirion SCD41 (separate from the VOC/NOx sensor).']

  // --- Phone state ---
  battery integer [note: 'Datasheet: `battery_phone_pct`. Unit: %. Remaining battery charge on the phone (not the Atmotube). Source: phone OS.']
  charging boolean [note: 'Datasheet: `charge_phone_bool`. Whether the phone was actively charging during data collection (raw value `yes`).']
  recently_charged boolean [note: '''
    Datasheet: `cooldown_phone_bool`. Whether the phone was in a post-charge cooldown state (raw value `cd`).
    Kept separate from `charging` because cooldown may still affect phone/sensor performance.
  ''']
  motion boolean [note: 'Datasheet: `motion_phone_bool` (renamed from `motion_now_bool`). Whether the device was moving at the time of the reading. Source: phone motion sensors.']

  // --- GIS / location (phone GPS) ---
  altitude double [note: '''
    Datasheet: `altitude`. Unit: m. Current elevation, derived from barometric pressure (Bosch BME280).
    Optional: only present if an altitude-like column is detected in the source export.
  ''']
  position_error double [note: '''
    Datasheet: `position_error_m`. Unit: m. Estimated accuracy of the phone's GPS fix.
    Reflects the phone's GNSS chip, not the Atmotube. PRO 2 only.
  ''']
  satellites_fixed integer [note: '''
    Datasheet: `sat_used_count` (renamed from `sat_fix_count`). Unit: count. Satellites used to calculate the location fix.
    Minimum 4 for a 3D fix [lon, lat, alt]; minimum 3 for a 2D fix [lon, lat]. PRO 2 only.
  ''']
  satellites_in_view integer [note: 'Datasheet: `sat_view_count`. Unit: count. Number of satellites currently in view. PRO 2 only.']
  location geometry [note: '''
    GEOMETRY(Point, 4326), calculated from datasheet `longitude` and `latitude` (degrees; 0 = equator / prime meridian). Source: phone GPS (the Atmotube has no internal GPS module).
    Data-quality rule: rows with null lat/lon, or exactly (0.0, 0.0) ("null island"), are treated as invalid and carry no location/timezone.
  ''']

  // --- Pipeline ---
  interpolated_cols "text[]" [note: 'Pipeline field (not in datasheet). Names of columns whose values in this row were interpolated rather than measured.']
  ingest_id bigint [not null, note: 'Points back to the raw.ingests payload this row came from.']

  indexes {
    (usr_id, recorded_at) [unique]
  }

  Note: '''
    TimescaleDB hypertable. partition: recorded_at, segmentby: usr_id. Creates location geometry from longitude + latitude.

    Atmotube PRO 2 data, mapped from the parser output in `src/parsers/atmotube.py` (see Atmotube datasheet). Each column note starts with the datasheet variable name it comes from.

    TODO: variables with NO column in this table: `sat_lowsignal_count`, `sat_medsignal_count`, `sat_highsignal_count`, `sat_signal_avg`, `user_notes`.
  '''
}

Table readings.fitbit6_ecg {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at timestamptz [not null]
  ended_at timestamptz [not null]
  result_type text
  hr_avg_bpm integer
  sampling_hz integer
  millivolts_scf integer
  lead_num integer
  waveform_data "text[]"
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at, ended_at) [unique]
    (usr_id, started_at) [name: 'idx_fitbit6_ecg_usr_time']
  }
}

Table readings.fitbit6_exercise {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at timestamptz [not null]
  ended_at timestamptz [not null]
  result_type text
  method text [note: 'PASSIVELY_MEASURED | ACTIVELY_MEASURED']
  calories_kcal double
  hr_avg_bpm integer
  hr_zone_light_sec integer
  hr_zone_moderate_sec integer
  hr_zone_vigorous_sec integer
  hr_zone_peak_sec integer
  exercise_events jsonb
  metadata jsonb
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at, ended_at) [unique]
    (usr_id, started_at) [name: 'idx_fitbit6_exercise_usr_time']
  }
}

Table readings.fitbit6_sleep {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at timestamptz [not null]
  ended_at timestamptz [not null]
  result_type text [note: 'STAGES | CLASSIC | UNSPECIFIED']
  nap boolean
  sleep_stages_data jsonb
  sleep_sum_data jsonb
  sum_insleep_mins integer
  sum_towakeup_mins integer
  sum_tosleep_mins integer
  sum_asleep_mins integer
  sum_awake_mins integer
  metadata jsonb
  rr_sample_end timestamptz
  rr_deep_pm double
  rr_deep_stddev double
  rr_deep_snr double
  rr_light_pm double
  rr_light_stddev double
  rr_light_snr double
  rr_rem_pm double
  rr_rem_stddev double
  rr_rem_snr double
  rr_full_pm double
  rr_full_stddev double
  rr_full_snr double
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at, ended_at) [unique]
    (usr_id, started_at) [name: 'idx_fitbit6_sleep_usr_time']
  }

  Note: 'Combines sleep + respiratory-rate-sleep-summary'
}

Table readings.fitbit6_days {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at date [not null]
  ended_at date [not null, note: 'exclusive: started_at + 1 day']
  hr_resting_bpm integer
  hr_resting_method text
  hr_nonrem_bpm integer
  hrv_avgsleep_rmssdms double
  hrv_avgsleep_entropy double
  hrv_deepsleep_rmssdms double
  spo2_avg_pct double
  spo2_min_pct double
  spo2_max_pct double
  spo2_stddev_pct double
  rr_pm double
  hr_zone_light_min integer
  hr_zone_light_max integer
  hr_zone_moderate_min integer
  hr_zone_moderate_max integer
  hr_zone_vigorous_min integer
  hr_zone_vigorous_max integer
  hr_zone_peak_min integer
  hr_zone_peak_max integer
  hr_zones_kcal_data jsonb
  sleep_temp_avg_c double
  sleep_temp_baseline_c double
  sleep_temp_rstddev_c double
  vo2_max_data jsonb
  floors_num integer
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at) [unique]
  }

  Note: 'Daily (24-hr aggregated)'
}

Table readings.fitbit6 {
  usr_id bigint [not null]
  recorded_at timestamptz [not null]
  hr_bpm integer
  hrv_rmssdms double
  spo2_pct double
  steps_num integer
  distance_mm double
  hr_zone_desc text
  hr_zone_type text
  activity_level text
  activity_kcal double
  ecg_id bigint
  exercise_id bigint
  sleep_id bigint
  irn boolean
  sedentary boolean
  altitude_mm double
  bodyfat_pct double
  weight_g double
  height_mm integer
  body_temp_data jsonb
  bld_glucose_data jsonb
  interpolated_cols "text[]"
  ingest_id bigint [not null]

  indexes {
    (usr_id, recorded_at) [unique]
  }

  Note: 'TimescaleDB hypertable. partition: recorded_at, segmentby: usr_id. Combines continuous + interval + session data'
}

// ---------------------------------------------------------------------------
// accounts: append-only attribute snapshots
// ---------------------------------------------------------------------------

Table accounts.usr {
  id bigint [pk, increment]
  usr_id bigint [not null]
  recorded_at timestamptz [not null]
  attrs jsonb [not null, note: "e.g. fitbit profile data"]
  ingest_id bigint

  indexes {
    (usr_id, recorded_at) [unique]
  }

  Note: 'Optional. account data from the device. Append-only: a row is added only when attrs differs from the latest snapshot.'
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

Ref: registry.dvc.type > registry.type.id
Ref: registry.acc.type > registry.type.id
Ref: registry.ppt.site > registry.site.id

// Cascade: a site change on ppt, or a type change on dvc / acc, updates the matching usr rows.
// The dvc and acc keys are also DEFERRABLE INITIALLY IMMEDIATE (not expressible in DBML).
Ref: registry.usr.(ppt_id, site) > registry.ppt.(id, site) [update: cascade]
Ref: registry.usr.(dvc_id, type) > registry.dvc.(id, type) [update: cascade]
Ref: registry.usr.(acc_id, type) > registry.acc.(id, type) [update: cascade]

Ref: raw.ingests.(usr_id, type) > registry.usr.(id, type)
Ref: raw.pipeline.(usr_id, type) > registry.usr.(id, type)
Ref: raw.pull_coverage.(usr_id, type) > registry.usr.(id, type)
Ref: raw.pull_coverage.ingest_id > raw.ingests.id

Ref: readings.atmotube2.usr_id > registry.usr.id
Ref: readings.atmotube2.ingest_id > raw.ingests.id

Ref: readings.fitbit6_ecg.usr_id ?> registry.usr.id
Ref: readings.fitbit6_ecg.ingest_id ?> raw.ingests.id
Ref: readings.fitbit6_exercise.usr_id ?> registry.usr.id
Ref: readings.fitbit6_exercise.ingest_id ?> raw.ingests.id
Ref: readings.fitbit6_sleep.usr_id ?> registry.usr.id
Ref: readings.fitbit6_sleep.ingest_id ?> raw.ingests.id
Ref: readings.fitbit6_days.usr_id ?> registry.usr.id
Ref: readings.fitbit6_days.ingest_id ?> raw.ingests.id

Ref: readings.fitbit6.usr_id > registry.usr.id
Ref: readings.fitbit6.ingest_id > raw.ingests.id
Ref: readings.fitbit6.ecg_id > readings.fitbit6_ecg.id
Ref: readings.fitbit6.exercise_id > readings.fitbit6_exercise.id
Ref: readings.fitbit6.sleep_id > readings.fitbit6_sleep.id

Ref: accounts.usr.usr_id ?> registry.usr.id
Ref: accounts.usr.ingest_id ?> raw.ingests.id

// ---------------------------------------------------------------------------
// Groups (one per schema)
// ---------------------------------------------------------------------------

TableGroup registry {
  registry.type
  registry.site
  registry.dvc
  registry.ppt
  registry.acc
  registry.usr

  Note: 'Synced from config/study_registry.yml (source of truth): new values are added, changed values updated, removed values deleted.'
}

TableGroup raw {
  raw.ingests
  raw.pipeline
  raw.pull_coverage

  Note: 'Raw payloads, run logs and pull coverage.'
}

TableGroup readings {
  readings.atmotube2
  readings.fitbit6
  readings.fitbit6_ecg
  readings.fitbit6_exercise
  readings.fitbit6_sleep
  readings.fitbit6_days

  Note: 'Processed device data, upserted on (usr_id, time).'
}

TableGroup accounts {
  accounts.usr

  Note: 'Optional account attribute snapshots.'
}
