// multidevice-study-pipeline: DBML for dbdiagram.io
// Source: deploy/postgres/init/02_registry.sql ... 05_accounts.sql

Project "multidevice_study_pipeline" {
  database_type: 'PostgreSQL'
  note: '''

      Postgres + PostGIS + TimescaleDB store for a study conducted with multiple device types, for multiple participant sites, and rotating device assignments over time.

      ## Schemas
      - **registry**: the study design. Participants (`ppt`), devices (`dvc`), accounts (`acc`), sites and device types, synced from `study_registry.yml`, which is the source of truth. `registry.usr` links one participant, one device and one account over a date window, and constraints prevent overlapping windows per device and per account.
      - **raw**: pipeline records. `ingests` holds each raw API payload as JSONB (append-only), `pipeline` logs the status of each run (one row per usr per run, updated once when the run ends), and `pull_coverage` records which date ranges have been fully pulled (append-only), so backfills only fetch the gaps.
      - **readings**: processed data, with typed columns, standardized units and UTC timestamps. Every device type requires a TimescaleDB hypertable for longitudinal visualization (e.g., `readings.atmotube2`, `readings.fitbit6`). If a device type has heterogeneous data, it may require additional tables to fit it into a longitudinal table (e.g., `readings.fitbit6_*`)
      - **accounts**: optional snapshots of account data from a device with an account (e.g. Fitbit profile data). A row is appended only when the data differs from the latest snapshot.

      ## Conventions
      - `usr_id` identifies an *assignment* (participant + device + account over time), not a person. A participant who switches devices gets a new `usr` row, so join through `registry.usr.ppt_id` to combine their data.
      - Every processed row carries an `ingest_id` pointing back to the raw payload it came from.
      - Readings are upserted on their unique key (`usr_id` + time), so re-pulling an overlapping date range is safe.
      - Timestamps are `timestamptz` in UTC. Column suffixes give the unit (`_bpm`, `_pct`, `_mm`, `_kcal`).

      ## Registry sync
      `config/study_registry.yml` is the single source of truth. Running `python -m load.scripts.seed_registry` makes `registry.*` mirror it in one transaction (any error rolls everything back):
      - New values in the yml are inserted, changed values are updated, and values removed from the yml are deleted (children before parents).
      - `registry.usr` rows keep their `id` when only dates or accounts change, so readings stay attached to the same usr. A change that would orphan loaded data is refused by the foreign keys.
      - The yml is validated first. A bad yml (unset env variable, type mismatch, overlapping windows) changes nothing.
      - Credentials are read from the yml in memory and are never written to the database.
      - The sync is run manually. The scheduled daily job does not call it.

      Views and indexes are not shown here.
  '''
}



// ---------------------------------------------------------------------------
// registry: data ABOUT devices and participants (synced from study_registry.yml)
// ---------------------------------------------------------------------------

Table registry.type {
  id text [pk]

  Note: '''
    List of evice Types. 

    Operations: UPSERT (insert, do nothing if it exists), DELETE 
    Written by: sync_registry()
   '''
}

Table registry.site {
  id text [pk]

  Note: '''
    List of participant Sites. 

    Operations: UPSERT (insert, do nothing if it exists), DELETE 
    Written by: sync_registry()
  '''
}

Table registry.dvc {
  id text [pk]
  type text [not null]
  started_at date [not null]
  ended_at date
  notes text
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, type) [unique]
  }
  Note: '''
    List of Devices.
    
    Operations: UPSERT (update if the row differs), DELETE
    Written by: sync_registry()
  '''
}

Table registry.ppt {
  id text [pk]
  site text [not null]
  started_at date [not null]
  ended_at date
  notes text
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, site) [unique]
  }
  Note: '''
    List of Participant. 
    
    Operations: UPSERT (update if the row differs), DELETE
    Written by: sync_registry()
  '''
}

Table registry.acc {
  id text [pk]
  type text [not null]
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, type) [unique]
  }
  Note: '''
    List of Accounts (access points). 
      
    Operations: UPSERT (update if the row differs), DELETE
    Written by: sync_registry()
  '''
}

Table registry.usr {
  id bigint [pk, increment]
  ppt_id text [not null]
  dvc_id text [not null]
  acc_id text [not null]
  type text [not null, note: 'same type on device and account/access']
  site text [not null, note: 'same site as the participant']
  started_at date [not null]
  ended_at date
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (id, type) [unique]
  }
  Note: '''
    CENTRAL: participant (ppt) + device (dvc) + account (acc) + over a time window (started_at/ended_at) → generates a unique user instance (usr_id). 

    Why these four args? Two device type models: 
      1) dvc ||--|{ acc ||--|| ppt (one device, multiple account, one per participant / acc id identifies each ppt's data)
      2) dvc ||--|| acc ||--|{ ppt (one device, one account, shared among participants / time window identifies each ppt's data)
      
    Operations: INSERT, UPDATE (keeps the id), DELETE
    Written by: sync_registry() via _sync_usr()
  '''
} 
// ---------------------------------------------------------------------------
// raw: pipeline metadata and raw payloads
// ---------------------------------------------------------------------------

Table raw.ingests {
  id bigint [pk, increment]
  usr_id bigint [not null]
  type text [not null]
  ingest_kind text [not null, note: '''
    api_forwardfill | api_backfill | csv_backfill | test
  ''']
  pulled_at timestamptz [not null, default: `now()`]
  payload jsonb [not null]

  indexes {
    (usr_id, pulled_at) [name: 'idx_ingests']
  }
  Note: '''
    To backup raw pulls per usr.   

    Operations: INSERT
    Written by: load_raw_data()
  '''
}

Table raw.pipeline {
  id bigint [pk, increment]
  usr_id bigint [not null]
  type text [not null]
  status text [not null, default: 'running', note: 'running | success | partial | failed']
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  error_message text

  indexes {
    (usr_id, started_at) [name: 'idx_pipeline']
  }
  Note: '''
    To monitor pipeline runs per usr.
    Inserted at the start, status = `running`; updated at the end, status = 'success | partial | failed'.
        
    Operations: INSERT, then UPDATE
    Written by: log_pipeline.py, called from load_processed_data()
  '''
}

Table raw.pull_coverage {
  id bigint [pk, increment]
  usr_id bigint [not null]
  type text [not null]
  data_type text [not null, note: 'endpoint name from the type registry']
  covered tstzrange [not null, note: '[start, end) in UTC that the pull fully scanned']
  status text [not null, note: 'success | partial | failed']
  rows_loaded integer [not null]
  pages integer
  ingest_id bigint [not null]
  pulled_at timestamptz [not null, default: `now()`]

  indexes {
    (usr_id, data_type) [name: 'idx_pull_coverage']
  }
  Note: '''
    To track date coverage per usr.
    Only success rows count as covered, and raw.pull_gaps() uses them to find which date ranges to pull data for.

    Operations: INSERT
    Written by: backfill.py and additional CSV readers in 'src/extract/scripts'
  '''
}

// ---------------------------------------------------------------------------
// readings: processed device data
// ---------------------------------------------------------------------------

Table readings.atmotube2 {
  usr_id bigint [not null, note: 'Assignment of participant + device + account, not a person.']
  recorded_at timestamptz [not null, note: '''
    Unit: ISO 8601, UTC-aware. 
    Desc: Standardized timestamp and the key used to merge all parser category tables.
  ''']
  aqs integer [note: '''
    Unit: Score 0-100 (integer), 0-20 = severely polluted | 21-40 = very polluted | 41-60 = polluted | 61-80 = moderate | 81-100 = good.
    Desc: Aggregate Air Quality Score calculated from CO2, TVOC, NOx, PM1, PM2.5, PM10.
    Source: N/A
  ''']

  pm1 double [note: '''
    Unit: ug/m3 (microgram per cubic meter).
    Desc: Mass concentration of particles ≤ 1.0 um (micrometer) per atmospheric volume of air (cubic meter); used in AQS score.
    Source: Sensirion SPS30.
  ''']
  pm25 double [note: '''
    Unit: ug/m3 (microgram per cubic meter).
    Desc: Mass concentration of particles ≤ 2.5 um (micrometer) per atmospheric volume of air (cubic meter); used in AQS score.
    Source: Sensirion SPS30.
  ''']
  pm10 double [note: '''
    Unit: ug/m3 (microgram per cubic meter).
    Desc: Mass concentration of particles ≤ 10 um (micrometer) per atmospheric volume of air (cubic meter) used in AQS score. 
    Source: Sensirion SPS30.
  ''']

  pm_size double [note: '''
    Unit: nm  (nanometer).
    Desc: Average particle size (diameter) from raw count. 
    Source: Sensirion SPS30.
  ''']
  pm05_num integer [note: '''
    Unit: um (micrometer).
    Desc: Raw count of particles ≤ 0.5 um (micrometer) per unit volume. 
    Source: Sensirion SPS30.
  ''']
  pm1_num integer [note: '''
    Unit: um (micrometer).
    Desc: Raw count of particles ≤ 1.0 um (micrometer) per unit volume. 
    Source: Sensirion SPS30.
  ''']
  pm10_num integer [note: '''
    Unit: um (micrometer).
    Desc: Raw count of particles ≤ 10 um (micrometer) per unit volume. 
    Source: Sensirion SPS30.
  ''']
  pm25_num integer [note: '''
    Unit: um (micrometer).
    Desc: Raw count of particles ≤ 2.5 um (micrometer) per unit volume. 
    Source: Sensirion SPS30.
  '''] 
 
  temperature double [note: '''
    Unit: c (celcius degrees).
    Desc: Actual temperature of the device's surrounding air (AKA ambient tempreature); used to compensate CO2 and TVOC/NOx sensor readings for thermal drift.
    Source: Sensirion SHT40-AD1B.
  ''']
  humidity double [note: '''
    Unit: % (percent), 0 = dry | 100 = saturated.
    Desc: Water vapor in the air relative to the maximum it can hold at that temperature (AKA relative humidity). 
    Source: Sensirion SHT40-AD1B.
  ''']
  pressure double [note: '''
    Unit: hPa (hectopascals).
    Desc: Atmospheric pressure at the device's current elevation; decreases with altitude (~1 hPa per 8 m); not used in the AQS score.
    Source: Infineon DPS310
  ''']

  voc double [note: '''
    Unit: ppm (parts per million).
    Desc: Absolute concentration of Total Volatile Organic Compounds in the air; used in the AQS score.
    Source: Sensirion SGP41.   
  ''']
  voc_index integer [note: '''
    Unit: index, 100 = baseline | >100 = more polluted |<100 = cleaner.
    Desc: TVOC score relative to a rolling 24-hour baseline; used in the AQS score.
    Source: Sensirion SGP41.   
  ''']
  nox_index integer [note: '''
    Unit: index, 100 = baseline | >100 = more polluted |<100 = cleaner.
    Desc: Score for NO + NO2 relative to a rolling 24-hour baseline; used in the AQS score.
    Source: Sensirion SGP41.   
  ''']
  co2 double [note:  '''
    Unit: ppm (parts per million).
    Desc: Absolute concentration of carbon dioxide in the air; used in the AQS score.
    Source: Sensirion STCC4.   
  ''']

  battery integer [note:  '''
    Unit: % (percent).
    Desc: Remaining battery charge of the phone connected to the Atmotube device.
    Source: Phone OS.    
  ''']
  charging boolean [note:  '''
    Unit: boolean.
    Desc: Whether the phone was actively charging during the reading; temperature and humidity can be hidden/paused while the device is charging due to self-heating.
    Source: Phone OS.      
  ''']
  recently_charged boolean [note: '''
    Unit: boolean.
    Desc: Whether the phone was in a post-charge cooldown state; separate from `charging` because residual heat from charging can still affect sensor readings.
    Source: Phone OS.   
  ''']
  motion boolean [note:  '''
    Unit: boolean.
    Desc: Whether the device was in motion at the time of the reading.
    Source: MiraMEMS da213B.   
   ''']

  altitude double [note: '''
    Unit: m (meters).
    Desc: Verticle height relative to the mean sea level of the device; Optional: if built-in GPS is off, there will be NO reading.
    Source: Allystar TAU1113.   
  ''']
  position_error double [note: '''
    Unit: m (meters), smaller value = more precise.
    Desc: Estimated accuracy/uncertainty in the longitude and latitude of the device; if built-in GPS is off, readings are taken from the phone's GPS.
    Source: Phone OS / Allystar TAU1113.   
  ''']
  satellites_fixed integer [note: '''
    Unit: count.
    Desc: Raw count of satellites used to calculate the location fix of the device; minimum 4 for a 3D fix (longitude, latitude, altitude), minimum 3 for a 2D fix (longitude, latitude), Optional: if built-in GPS is off, there will be not altitude reading.
    Source: Allystar TAU1113.   
  ''']
  satellites_in_view integer [note: '''
    Unit: count, large value = improved location accuracy. 
    Desc: Raw count of satellites currently in view of the device; Optional: if built-in GPS is off, there will be not NO reading.
    Source: Allystar TAU1113.   
  ''']

  snr_0_19 integer [note: '''
    Unit: count.
    Desc: Satellites in view with SNR in the 0-19 range (low signal strength); Optional: if built-in GPS is off, there will be not NO reading.
    Source: Allystar TAU1113.
  ''']
  snr_20_49 integer [note: '''
    Unit: count.
    Desc: Satellites in view with SNR in the 20-49 range (medium signal strength); Optional: if built-in GPS is off, there will be not NO reading.
    Source: Allystar TAU1113.
  ''']
  snr_50_99 integer [note: '''
    Unit: count.
    Desc: Satellites in view with SNR in the 50-99 range (high signal strength); Optional: if built-in GPS is off, there will be not NO reading.
    Source: Allystar TAU1113.
  ''']
  snr_avg double [note: '''
    Unit: snr (signal-to-noise ratio).
    Desc: Average satellite signal strength relative to surrounding electronic background noise; Optional: if built-in GPS is off, there will be not NO reading.
    Source: Allystar TAU1113.
  ''']
  user_notes text [note: '''
    Unit: text.
    Desc: Free-text notes entered by the user; only present in CSV exports; Optional: only available from CSV exports not API pulls.
    Source: Atmotube PRO 2 App.
  ''']

  location geometry [note: '''
    Unit: GEOMETRY(Point, 4326).
    Desc: Point location calculated from recorded longitude and latitude of the device; for data quality, rows with null lat/lon or exactly (0.0, 0.0, AKA null island) are invalid.
    Source: Phone OS / Allystar TAU1113.   
  ''']

  interpolated_cols "text[]" [note: 'Names of columns whose values in the row were interpolated (e.g., location from longitude and latitude).']
  ingest_id bigint [not null, note: 'To identify the raw data for this row in raw.ingests payload.']

  indexes {
    (usr_id, recorded_at) [unique]
  }

  Note: '''
    TimescaleDB hypertable for Atmotube PRO 2 data. 
    Partition: recorded_at, Segmentby: usr_id.

    Operations: UPSERT on (usr_id, recorded_at)
    Written by: load_processed_data()
  
    Sources: 
      - https://support.atmotube.com/en/articles/12629420-atmotube-pro-2-technical-specifications
      - https://support.atmotube.com/en/articles/12621821-understanding-atmotube-pro-2-air-quality-score-aqs 
      - https://support.atmotube.com/en/articles/12714501-atmotube-pro-2-api-documentation
      - https://cdn.shopify.com/s/files/1/2156/7147/files/Atmotube_PRO_2_-_API_specification_-_v.1.5.pdf?v=1778851938
      - https://github.com/atmotube/atmotube-android-ble/blob/b01986d010a6771545e5f7ce183bece20426c493/atmotubeble/src/main/java/com/atmotube/ble/AtmotubeUtils.java#L84
      - https://support.atmotube.com/en/articles/13002682-history-mode-overview

  '''
}

Table readings.fitbit6_ecg {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at timestamptz [not null]
  ended_at timestamptz [not null]
  result_type text
  hr_avg_bpm integer
  sampling_hz integer
  millivolts_scf integer
  lead_num integer
  waveform_data "text[]"
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at, ended_at) [unique]
    (usr_id, started_at) [name: 'idx_fitbit6_ecg_usr_time']
  }
}

Table readings.fitbit6_exercise {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at timestamptz [not null]
  ended_at timestamptz [not null]
  result_type text
  method text [note: 'PASSIVELY_MEASURED | ACTIVELY_MEASURED']
  calories_kcal double
  hr_avg_bpm integer
  hr_zone_light_sec integer
  hr_zone_moderate_sec integer
  hr_zone_vigorous_sec integer
  hr_zone_peak_sec integer
  exercise_events jsonb
  metadata jsonb
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at, ended_at) [unique]
    (usr_id, started_at) [name: 'idx_fitbit6_exercise_usr_time']
  }
}

Table readings.fitbit6_sleep {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at timestamptz [not null]
  ended_at timestamptz [not null]
  result_type text [note: 'STAGES | CLASSIC | UNSPECIFIED']
  nap boolean
  sleep_stages_data jsonb
  sleep_sum_data jsonb
  sum_insleep_mins integer
  sum_towakeup_mins integer
  sum_tosleep_mins integer
  sum_asleep_mins integer
  sum_awake_mins integer
  metadata jsonb
  rr_sample_end timestamptz
  rr_deep_pm double
  rr_deep_stddev double
  rr_deep_snr double
  rr_light_pm double
  rr_light_stddev double
  rr_light_snr double
  rr_rem_pm double
  rr_rem_stddev double
  rr_rem_snr double
  rr_full_pm double
  rr_full_stddev double
  rr_full_snr double
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at, ended_at) [unique]
    (usr_id, started_at) [name: 'idx_fitbit6_sleep_usr_time']
  }

  Note: 'Combines sleep + respiratory-rate-sleep-summary'
}

Table readings.fitbit6_days {
  id bigint [pk, increment]
  usr_id bigint [not null]
  started_at date [not null]
  ended_at date [not null, note: 'exclusive: started_at + 1 day']
  hr_resting_bpm integer
  hr_resting_method text
  hr_nonrem_bpm integer
  hrv_avgsleep_rmssdms double
  hrv_avgsleep_entropy double
  hrv_deepsleep_rmssdms double
  spo2_avg_pct double
  spo2_min_pct double
  spo2_max_pct double
  spo2_stddev_pct double
  rr_pm double
  hr_zone_light_min integer
  hr_zone_light_max integer
  hr_zone_moderate_min integer
  hr_zone_moderate_max integer
  hr_zone_vigorous_min integer
  hr_zone_vigorous_max integer
  hr_zone_peak_min integer
  hr_zone_peak_max integer
  hr_zones_kcal_data jsonb
  sleep_temp_avg_c double
  sleep_temp_baseline_c double
  sleep_temp_rstddev_c double
  vo2_max_data jsonb
  floors_num integer
  ingest_id bigint [not null]

  indexes {
    (usr_id, started_at) [unique]
  }

  Note: '''
    Daily (24-hr aggregated).

    Operations: UPSERT on (usr_id, recorded_at)
    Written by: load_processed_data()
  '''
}

Table readings.fitbit6 {
  usr_id bigint [not null]
  recorded_at timestamptz [not null]
  hr_bpm integer
  hrv_rmssdms double
  spo2_pct double
  steps_num integer
  distance_mm double
  hr_zone_desc text
  hr_zone_type text
  activity_level text
  activity_kcal double
  ecg_id bigint
  exercise_id bigint
  sleep_id bigint
  irn boolean
  sedentary boolean
  altitude_mm double
  bodyfat_pct double
  weight_g double
  height_mm integer
  body_temp_data jsonb
  bld_glucose_data jsonb
  interpolated_cols "text[]"
  ingest_id bigint [not null]

  indexes {
    (usr_id, recorded_at) [unique]
  }

  Note: '''
    TimescaleDB hypertable for Fitbit Charge 6 data (combines continuous + interval + session data).
    Partition: recorded_at, Segmentby: usr_id.

    Operations: UPSERT on (usr_id, recorded_at)
    Written by: load_processed_data()
  '''
}

// ---------------------------------------------------------------------------
// accounts: append-only attribute snapshots
// ---------------------------------------------------------------------------

Table accounts.usr {
  id bigint [pk, increment]
  usr_id bigint [not null]
  recorded_at timestamptz [not null]
  attrs jsonb [not null, note: "e.g. fitbit profile data"]
  ingest_id bigint

  indexes {
    (usr_id, recorded_at) [unique]
  }

  Note: 'Optional. account data from the device. Append-only: a row is added only when attrs differs from the latest snapshot.'
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

Ref: registry.dvc.type > registry.type.id
Ref: registry.acc.type > registry.type.id
Ref: registry.ppt.site > registry.site.id

// Cascade: a site change on ppt, or a type change on dvc / acc, updates the matching usr rows.
// The dvc and acc keys are also DEFERRABLE INITIALLY IMMEDIATE (not expressible in DBML).
Ref: registry.usr.(ppt_id, site) > registry.ppt.(id, site) [update: cascade]
Ref: registry.usr.(dvc_id, type) > registry.dvc.(id, type) [update: cascade]
Ref: registry.usr.(acc_id, type) > registry.acc.(id, type) [update: cascade]

Ref: raw.ingests.(usr_id, type) > registry.usr.(id, type)
Ref: raw.pipeline.(usr_id, type) > registry.usr.(id, type)
Ref: raw.pull_coverage.(usr_id, type) > registry.usr.(id, type)
Ref: raw.pull_coverage.ingest_id > raw.ingests.id

Ref: readings.atmotube2.usr_id > registry.usr.id
Ref: readings.atmotube2.ingest_id > raw.ingests.id

Ref: readings.fitbit6_ecg.usr_id ?> registry.usr.id
Ref: readings.fitbit6_ecg.ingest_id ?> raw.ingests.id
Ref: readings.fitbit6_exercise.usr_id ?> registry.usr.id
Ref: readings.fitbit6_exercise.ingest_id ?> raw.ingests.id
Ref: readings.fitbit6_sleep.usr_id ?> registry.usr.id
Ref: readings.fitbit6_sleep.ingest_id ?> raw.ingests.id
Ref: readings.fitbit6_days.usr_id ?> registry.usr.id
Ref: readings.fitbit6_days.ingest_id ?> raw.ingests.id

Ref: readings.fitbit6.usr_id > registry.usr.id
Ref: readings.fitbit6.ingest_id > raw.ingests.id
Ref: readings.fitbit6.ecg_id > readings.fitbit6_ecg.id
Ref: readings.fitbit6.exercise_id > readings.fitbit6_exercise.id
Ref: readings.fitbit6.sleep_id > readings.fitbit6_sleep.id

Ref: accounts.usr.usr_id ?> registry.usr.id
Ref: accounts.usr.ingest_id ?> raw.ingests.id

// ---------------------------------------------------------------------------
// Groups (one per schema)
// ---------------------------------------------------------------------------

TableGroup registry {
  registry.type
  registry.site
  registry.dvc
  registry.ppt
  registry.acc
  registry.usr

  Note: 'Synced from config/study_registry.yml (source of truth): new values are added, changed values updated, removed values deleted.'
}

TableGroup raw {
  raw.ingests
  raw.pipeline
  raw.pull_coverage

  Note: 'Raw payloads, run logs and pull coverage.'
}

TableGroup readings {
  readings.atmotube2
  readings.fitbit6
  readings.fitbit6_ecg
  readings.fitbit6_exercise
  readings.fitbit6_sleep
  readings.fitbit6_days

  Note: 'Processed device data, upserted on (usr_id, time).'
}

TableGroup accounts {
  accounts.usr

  Note: 'Optional account attribute snapshots.'
}
